<configuration>
	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />
		

		
		
		<!--
		Local: Keep it "Off" so you can see errors while coding.
		Production: Change it to "On" or "RemoteOnly".
		-->
		
		<customErrors mode="RemoteOnly" />
		
		
	</system.web>
	<runtime>
